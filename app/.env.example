# OpenAI
OPENAI_API_KEY=sk-...

# LANGSMITH
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="sample"

# LangChain 콜백 처리 방식
# false = 콜백/trace 를 동기 처리. vitest 처럼 짧게 끝나는 프로세스에서
# background trace 전송이 미완료된 채 종료되어 LangSmith UI 에 "진행 중(◯)"
# 상태로 남는 문제를 방지한다. 운영 서버처럼 장기 실행 프로세스에서는
# 기본값(true) 이 성능상 유리.
LANGCHAIN_CALLBACKS_BACKGROUND=false